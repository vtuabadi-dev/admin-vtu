<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0"
                  xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0"
                  id="Definitions_TravelUmroh"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.20.0">

  <!-- COLLABORATION / POOL DEFINITION -->
  <bpmn:collaboration id="Collaboration_Umroh">
    <bpmn:participant id="Participant_VauzaTamma" 
                      name="VAUZA TAMMA — PROSES BISNIS TRAVEL UMROH (End-to-End)" 
                      processRef="Process_TravelUmroh" />
    <bpmn:participant id="Participant_Telegram" name="Channel Telegram" />
    <bpmn:participant id="Participant_GDS" name="Sistem Tiketing (GDS / Consolidator)" />
    <bpmn:participant id="Participant_Nusuk" name="Nusuk / Muqeem" />
    <bpmn:participant id="Participant_Drive" name="Google Drive (Otomatis per Paket)" />
    
    <!-- MESSAGE FLOWS TO EXTERNAL SYSTEMS -->
    <bpmn:messageFlow id="MsgFlow_Telegram" sourceRef="Task_BroadcastTelegram" targetRef="Participant_Telegram" />
    <bpmn:messageFlow id="MsgFlow_GDS" sourceRef="Task_PesanTiket" targetRef="Participant_GDS" />
    <bpmn:messageFlow id="MsgFlow_Nusuk" sourceRef="Task_PengurusanVisa" targetRef="Participant_Nusuk" />
    <bpmn:messageFlow id="MsgFlow_Drive_TL" sourceRef="Task_LaporanPerjalanan" targetRef="Participant_Drive" />
    <bpmn:messageFlow id="MsgFlow_Drive_Finance" sourceRef="Task_RekapBayarVendor" targetRef="Participant_Drive" />
    <bpmn:messageFlow id="MsgFlow_Drive_Mkt" sourceRef="Task_FollowUp" targetRef="Participant_Drive" />
  </bpmn:collaboration>

  <!-- PROCESS DEFINITION -->
  <bpmn:process id="Process_TravelUmroh" isExecutable="false">
    
    <!-- LANESET -->
    <bpmn:laneSet id="LaneSet_1">
      <!-- 1. JAMAAH -->
      <bpmn:lane id="Lane_Jamaah" name="JAMAAH">
        <bpmn:flowNodeRef>StartEvent_Mulai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LihatPaket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DaftarOnline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadDokumen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DataLengkap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Bayar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Berangkat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ibadah</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Kembali</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Selesai</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- 2. MARKETING / SALES -->
      <bpmn:lane id="Lane_Marketing" name="MARKETING / SALES">
        <bpmn:flowNodeRef>Task_ListPaket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BroadcastTelegram</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FollowUp</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- 3. ADMIN OPERASIONAL -->
      <bpmn:lane id="Lane_AdminOps" name="ADMIN OPERASIONAL">
        <bpmn:flowNodeRef>Task_TerimaNotifDaftar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CekKelengkapan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputManifest</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- 4. DOKUMEN & VISA -->
      <bpmn:lane id="Lane_DokumenVisa" name="DOKUMEN &amp; VISA">
        <bpmn:flowNodeRef>Task_OCRPasporKTP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RekapDokumen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PengurusanVisa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StatusVisa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateStatusManifest</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- 5. FINANCE -->
      <bpmn:lane id="Lane_Finance" name="FINANCE">
        <bpmn:flowNodeRef>Task_VerifikasiBayar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BayarValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateManifestBayar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RekapBayarVendor</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- 6. TIKETING & VENDOR -->
      <bpmn:lane id="Lane_TiketingVendor" name="TIKETING &amp; VENDOR">
        <bpmn:flowNodeRef>Task_BlockSeat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PesanTiket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TerimaETicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KonfirmasiJamaah</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KoordinasiVendor</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- 7. TOUR LEADER / MUTAWIF -->
      <bpmn:lane id="Lane_TourLeader" name="TOUR LEADER / MUTAWIF">
        <bpmn:flowNodeRef>Task_Briefing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pendampingan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LaporanPerjalanan</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- FLOW NODES: PHASE 1 MARKETING & PAKET -->
    <bpmn:startEvent id="StartEvent_Mulai" name="Mulai">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_LihatPaket" name="Melihat Informasi Paket Umroh">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_BroadcastToJamaah</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ListPaket" name="Membuat &amp; Update List Paket">
      <bpmn:outgoing>Flow_Mkt_1</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Paket">
        <bpmn:targetRef>DataStoreRef_Paket</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_BroadcastTelegram" name="Broadcast Paket ke Telegram">
      <bpmn:incoming>Flow_Mkt_1</bpmn:incoming>
      <bpmn:outgoing>Flow_BroadcastToJamaah</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- FLOW NODES: PHASE 2 PENDAFTARAN -->
    <bpmn:userTask id="Task_DaftarOnline" name="Mengisi Formulir Pendaftaran (Online)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_DataLengkap_Tidak</bpmn:incoming>
      <bpmn:incoming>Flow_Valid_Tidak</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotifDaftar</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Pendaftaran">
        <bpmn:targetRef>DataStoreRef_Pendaftaran</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>

    <bpmn:userTask id="Task_UploadDokumen" name="Upload Dokumen (Paspor, KTP, Foto)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_DataLengkap" name="Data Lengkap?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_DataLengkap_Ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_DataLengkap_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_TerimaNotifDaftar" name="Menerima Notifikasi Pendaftaran">
      <bpmn:incoming>Flow_NotifDaftar</bpmn:incoming>
      <bpmn:outgoing>Flow_Ops_1</bpmn:outgoing>
      <bpmn:property id="Prop_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Pendaftaran">
        <bpmn:sourceRef>DataStoreRef_Pendaftaran</bpmn:sourceRef>
        <bpmn:targetRef>Prop_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>

    <bpmn:userTask id="Task_CekKelengkapan" name="Cek Kelengkapan Data">
      <bpmn:incoming>Flow_Ops_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Ops_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_Valid" name="Valid?">
      <bpmn:incoming>Flow_Ops_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid_Ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- FLOW NODES: PHASE 3 DOKUMEN & MANIFEST -->
    <bpmn:userTask id="Task_InputManifest" name="Input ke Manifest">
      <bpmn:incoming>Flow_Valid_Ya</bpmn:incoming>
      <bpmn:outgoing>Flow_To_OCR</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Manifest">
        <bpmn:targetRef>DataStoreRef_Manifest</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_OCRPasporKTP" name="OCR Paspor &amp; KTP (Ambil Data Otomatis)">
      <bpmn:incoming>Flow_To_OCR</bpmn:incoming>
      <bpmn:outgoing>Flow_OCR_To_Rekap</bpmn:outgoing>
      <bpmn:outgoing>Flow_OCR_To_Finance</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Paspor">
        <bpmn:targetRef>DataObjectRef_Paspor</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DOA_KTP">
        <bpmn:targetRef>DataObjectRef_KTP</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DOA_DataOCR">
        <bpmn:targetRef>DataStoreRef_DataOCR</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_RekapDokumen" name="Rekap Dokumen Jamaah">
      <bpmn:incoming>Flow_OCR_To_Rekap</bpmn:incoming>
      <bpmn:outgoing>Flow_Doc_To_Visa</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_PengurusanVisa" name="Pengurusan Visa (Nusuk)">
      <bpmn:incoming>Flow_Doc_To_Visa</bpmn:incoming>
      <bpmn:incoming>Flow_Visa_Tidak</bpmn:incoming>
      <bpmn:outgoing>Flow_To_VisaGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_StatusVisa" name="Status Visa Disetujui?">
      <bpmn:incoming>Flow_To_VisaGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Visa_Ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_Visa_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_UpdateStatusManifest" name="Update Status di Manifest">
      <bpmn:incoming>Flow_Visa_Ya</bpmn:incoming>
      <bpmn:outgoing>Flow_Visa_To_Berangkat</bpmn:outgoing>
      <bpmn:property id="Prop_EVisa" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_EVisa">
        <bpmn:sourceRef>DataObjectRef_EVisa</bpmn:sourceRef>
        <bpmn:targetRef>Prop_EVisa</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>

    <!-- FLOW NODES: PHASE 4 PEMBAYARAN -->
    <bpmn:userTask id="Task_Bayar" name="Melakukan Pembayaran">
      <bpmn:incoming>Flow_DataLengkap_Ya</bpmn:incoming>
      <bpmn:incoming>Flow_Bayar_Tidak</bpmn:incoming>
      <bpmn:outgoing>Flow_To_VerifBayar</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_BuktiBayar">
        <bpmn:targetRef>DataObjectRef_BuktiBayar</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>

    <bpmn:userTask id="Task_VerifikasiBayar" name="Verifikasi Pembayaran">
      <bpmn:incoming>Flow_To_VerifBayar</bpmn:incoming>
      <bpmn:incoming>Flow_OCR_To_Finance</bpmn:incoming>
      <bpmn:outgoing>Flow_To_BayarGateway</bpmn:outgoing>
      <bpmn:property id="Prop_BuktiBayar" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_BuktiBayar">
        <bpmn:sourceRef>DataObjectRef_BuktiBayar</bpmn:sourceRef>
        <bpmn:targetRef>Prop_BuktiBayar</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_BayarValid" name="Pembayaran Valid?">
      <bpmn:incoming>Flow_To_BayarGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Bayar_Ya</bpmn:outgoing>
      <bpmn:outgoing>Flow_Bayar_Tidak</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_UpdateManifestBayar" name="Update Manifest Pembayaran">
      <bpmn:incoming>Flow_Bayar_Ya</bpmn:incoming>
      <bpmn:outgoing>Flow_Fin_To_RekapVendor</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_DataBayar">
        <bpmn:targetRef>DataObjectRef_DataPembayaran</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DOA_DBBayar">
        <bpmn:targetRef>DataStoreRef_Pembayaran</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>

    <!-- FLOW NODES: PHASE 5 TIKETING & VENDOR -->
    <bpmn:serviceTask id="Task_BlockSeat" name="Generate Manifest Block Seat">
      <bpmn:incoming>Flow_Bayar_Ya</bpmn:incoming>
      <bpmn:outgoing>Flow_BlockSeat_To_Pesan</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_PesanTiket" name="Pemesanan Tiket (Flight)">
      <bpmn:incoming>Flow_BlockSeat_To_Pesan</bpmn:incoming>
      <bpmn:outgoing>Flow_Pesan_To_Terima</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_TerimaETicket" name="Terima E-Ticket &amp; Itinerary">
      <bpmn:incoming>Flow_Pesan_To_Terima</bpmn:incoming>
      <bpmn:outgoing>Flow_Terima_To_Konf</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_ETicket">
        <bpmn:targetRef>DataObjectRef_ETicket</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>

    <bpmn:userTask id="Task_KonfirmasiJamaah" name="Konfirmasi ke Jamaah">
      <bpmn:incoming>Flow_Terima_To_Konf</bpmn:incoming>
      <bpmn:outgoing>Flow_Konf_To_Vendor</bpmn:outgoing>
      <bpmn:outgoing>Flow_Konf_To_Briefing</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_KoordinasiVendor" name="Koordinasi Vendor (Hotel, Transport, dll)">
      <bpmn:incoming>Flow_Konf_To_Vendor</bpmn:incoming>
      <bpmn:outgoing>Flow_Vendor_To_RekapVendor</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_VoucherVendor">
        <bpmn:targetRef>DataObjectRef_VoucherVendor</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>

    <!-- FLOW NODES: PHASE 6 KEBERANGKATAN -->
    <bpmn:userTask id="Task_Briefing" name="Briefing Jamaah">
      <bpmn:incoming>Flow_Konf_To_Briefing</bpmn:incoming>
      <bpmn:outgoing>Flow_Briefing_To_Berangkat</bpmn:outgoing>
      <bpmn:outgoing>Flow_Briefing_To_Damping</bpmn:outgoing>
      <bpmn:property id="Prop_ETicket" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_ETicketBriefing">
        <bpmn:sourceRef>DataObjectRef_ETicket</bpmn:sourceRef>
        <bpmn:targetRef>Prop_ETicket</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Berangkat" name="Berangkat Umroh">
      <bpmn:incoming>Flow_Briefing_To_Berangkat</bpmn:incoming>
      <bpmn:incoming>Flow_Visa_To_Berangkat</bpmn:incoming>
      <bpmn:outgoing>Flow_Berangkat_To_Ibadah</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Ibadah" name="Menjalankan Ibadah di Tanah Suci">
      <bpmn:incoming>Flow_Berangkat_To_Ibadah</bpmn:incoming>
      <bpmn:outgoing>Flow_Ibadah_To_Kembali</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Pendampingan" name="Pendampingan Selama Perjalanan">
      <bpmn:incoming>Flow_Briefing_To_Damping</bpmn:incoming>
      <bpmn:outgoing>Flow_Damping_To_Laporan</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_LaporanPerjalanan" name="Laporan Perjalanan">
      <bpmn:incoming>Flow_Damping_To_Laporan</bpmn:incoming>
      <bpmn:dataOutputAssociation id="DOA_LaporanTL">
        <bpmn:targetRef>DataObjectRef_LaporanTL</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>

    <bpmn:userTask id="Task_RekapBayarVendor" name="Rekap Pembayaran Vendor">
      <bpmn:incoming>Flow_Vendor_To_RekapVendor</bpmn:incoming>
      <bpmn:incoming>Flow_Fin_To_RekapVendor</bpmn:incoming>
      <bpmn:property id="Prop_Voucher" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_VoucherRekap">
        <bpmn:sourceRef>DataObjectRef_VoucherVendor</bpmn:sourceRef>
        <bpmn:targetRef>Prop_Voucher</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_LapVendor">
        <bpmn:targetRef>DataObjectRef_LaporanVendor</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DOA_LapKeu">
        <bpmn:targetRef>DataObjectRef_LaporanKeuangan</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Kembali" name="Kembali ke Tanah Air">
      <bpmn:incoming>Flow_Ibadah_To_Kembali</bpmn:incoming>
      <bpmn:outgoing>Flow_Kembali_To_End</bpmn:outgoing>
      <bpmn:outgoing>Flow_Kembali_To_FollowUp</bpmn:outgoing>
    </bpmn:userTask>

    <!-- FLOW NODES: PHASE 7 PASCA PERJALANAN -->
    <bpmn:userTask id="Task_FollowUp" name="Follow Up Jamaah &amp; Testimoni">
      <bpmn:incoming>Flow_Kembali_To_FollowUp</bpmn:incoming>
      <bpmn:dataOutputAssociation id="DOA_LapFeedback">
        <bpmn:targetRef>DataObjectRef_LaporanFeedback</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Selesai" name="Selesai">
      <bpmn:incoming>Flow_Kembali_To_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- DATA OBJECTS -->
    <bpmn:dataObject id="DO_Paspor" />
    <bpmn:dataObjectReference id="DataObjectRef_Paspor" name="Paspor" dataObjectRef="DO_Paspor" />

    <bpmn:dataObject id="DO_KTP" />
    <bpmn:dataObjectReference id="DataObjectRef_KTP" name="KTP" dataObjectRef="DO_KTP" />

    <bpmn:dataObject id="DO_BuktiBayar" />
    <bpmn:dataObjectReference id="DataObjectRef_BuktiBayar" name="Bukti Pembayaran" dataObjectRef="DO_BuktiBayar" />

    <bpmn:dataObject id="DO_DataBayar" />
    <bpmn:dataObjectReference id="DataObjectRef_DataPembayaran" name="Data Pembayaran" dataObjectRef="DO_DataBayar" />

    <bpmn:dataObject id="DO_EVisa" />
    <bpmn:dataObjectReference id="DataObjectRef_EVisa" name="E-Visa" dataObjectRef="DO_EVisa" />

    <bpmn:dataObject id="DO_ETicket" />
    <bpmn:dataObjectReference id="DataObjectRef_ETicket" name="E-Ticket &amp; Itinerary" dataObjectRef="DO_ETicket" />

    <bpmn:dataObject id="DO_VoucherVendor" />
    <bpmn:dataObjectReference id="DataObjectRef_VoucherVendor" name="Voucher &amp; Konfirmasi Layanan" dataObjectRef="DO_VoucherVendor" />

    <bpmn:dataObject id="DO_LapVendor" />
    <bpmn:dataObjectReference id="DataObjectRef_LaporanVendor" name="Laporan Vendor" dataObjectRef="DO_LapVendor" />

    <bpmn:dataObject id="DO_LapKeu" />
    <bpmn:dataObjectReference id="DataObjectRef_LaporanKeuangan" name="Laporan Keuangan" dataObjectRef="DO_LapKeu" />

    <bpmn:dataObject id="DO_LapTL" />
    <bpmn:dataObjectReference id="DataObjectRef_LaporanTL" name="Laporan TL" dataObjectRef="DO_LapTL" />

    <bpmn:dataObject id="DO_LapFeedback" />
    <bpmn:dataObjectReference id="DataObjectRef_LaporanFeedback" name="Laporan Feedback" dataObjectRef="DO_LapFeedback" />

    <!-- DATA STORES -->
    <bpmn:dataStoreReference id="DataStoreRef_Paket" name="Database Paket" />
    <bpmn:dataStoreReference id="DataStoreRef_Pendaftaran" name="Database Pendaftaran" />
    <bpmn:dataStoreReference id="DataStoreRef_Manifest" name="Manifest Jamaah (SOT = Nama Paspor)" />
    <bpmn:dataStoreReference id="DataStoreRef_DataOCR" name="Data OCR" />
    <bpmn:dataStoreReference id="DataStoreRef_Pembayaran" name="Database Pembayaran" />

    <!-- SEQUENCE FLOWS -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Mulai" targetRef="Task_LihatPaket" />
