<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0"
                  xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0"
                  id="Definitions_VTU_Operasional"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.20.0">

  <!-- COLLABORATION / POOL -->
  <bpmn:collaboration id="Collaboration_VTU">
    <bpmn:participant id="Participant_VTU" 
                      name="VTU ABADI OPERASIONAL SYSTEM — END-TO-END BUSINESS PROCESS" 
                      processRef="Process_VTU_Operasional" />
    
    <!-- EXTERNAL PARTICIPANTS -->
    <bpmn:participant id="Participant_TelegramGateway" name="Telegram Broadcast &amp; Bot Gateway" />
    <bpmn:participant id="Participant_GeminiAI" name="Gemini AI Vision &amp; OCR Engine" />
    <bpmn:participant id="Participant_GoogleDrive" name="Google Drive Cloud Storage" />

    <!-- MESSAGE FLOWS -->
    <bpmn:messageFlow id="MF_Telegram_1" sourceRef="Task_Sys_BroadcastJadwal" targetRef="Participant_TelegramGateway" />
    <bpmn:messageFlow id="MF_Telegram_2" sourceRef="Task_Sys_SendReceipt" targetRef="Participant_TelegramGateway" />
    <bpmn:messageFlow id="MF_Telegram_3" sourceRef="Task_Sys_AutoDeadlines" targetRef="Participant_TelegramGateway" />
    <bpmn:messageFlow id="MF_Gemini_OCR" sourceRef="Task_Sys_OCRTrigger" targetRef="Participant_GeminiAI" />
    <bpmn:messageFlow id="MF_Gemini_PackageOCR" sourceRef="Task_Sub_GeminiVisionOCR" targetRef="Participant_GeminiAI" />
    <bpmn:messageFlow id="MF_Drive_Sync" sourceRef="Task_Sys_SyncDrive" targetRef="Participant_GoogleDrive" />
  </bpmn:collaboration>

  <!-- MAIN PROCESS -->
  <bpmn:process id="Process_VTU_Operasional" isExecutable="false">

    <!-- LANESET: 8 ROWS -->
    <bpmn:laneSet id="LaneSet_VTU">
      
      <!-- ROW 1. JAMAAH / KETUA GROUP -->
      <bpmn:lane id="Lane_Jamaah" name="JAMAAH / KETUA GROUP">
        <bpmn:flowNodeRef>Start_VTU</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_J_RegisterGroup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_J_PilihPaket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_J_KomposisiKamar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_J_UploadBuktiDP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_J_AmbilPerlengkapan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_J_UploadDokumen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_J_BayarPelunasan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_J_TerimaKwitansi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_J_Berangkat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_J_Pulang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_VTU</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- ROW 2. SISTEM VTU & AI ENGINE -->
      <bpmn:lane id="Lane_SistemAI" name="SISTEM VTU &amp; AI ENGINE">
        <bpmn:flowNodeRef>Task_Sys_BroadcastJadwal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_HitungNominal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_GenPDF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_IngestManifest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_OCRTrigger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OCRConfidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_CalcReadiness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_OCRPembayaran</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_SendReceipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_GenManifestNumber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_AutoDeadlines</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_SyncDrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sys_AuditLog</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- ROW 3. ADMIN OPERASIONAL (SUB-PROSES MANAJEMEN PAKET + REVIEW PENDAFTARAN) -->
      <bpmn:lane id="Lane_AdminOps" name="ADMIN OPERASIONAL">
        <bpmn:flowNodeRef>SubProcess_ManajemenPaket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ops_ReviewRegistrasi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewReg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ops_ClosingPaket</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- ROW 4. ADMIN DOKUMEN -->
      <bpmn:lane id="Lane_AdminDoc" name="ADMIN DOKUMEN">
        <bpmn:flowNodeRef>Task_Doc_ManualReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Doc_VerifyData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocStatus</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- ROW 5. ADMIN PEMBAYARAN -->
      <bpmn:lane id="Lane_AdminPay" name="ADMIN PEMBAYARAN (FINANCE)">
        <bpmn:flowNodeRef>Task_Pay_TerbitkanInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pay_InvoicePelunasan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pay_ReviewPembayaran</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PayApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pay_Alokasi</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- ROW 6. ADMIN MANIFEST & ROOMING -->
      <bpmn:lane id="Lane_AdminMan" name="ADMIN MANIFEST &amp; ROOMING">
        <bpmn:flowNodeRef>Task_Man_Provisioning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Man_SplitHotel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Man_RoomingEngine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ManifestFinal</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- ROW 7. TOUR LEADER -->
      <bpmn:lane id="Lane_TourLeader" name="TOUR LEADER">
        <bpmn:flowNodeRef>Task_TL_Handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TL_BriefingManasik</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TL_Dampingan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TL_Laporan</bpmn:flowNodeRef>
      </bpmn:lane>

      <!-- ROW 8. ADMIN BADAL & WAKAF -->
      <bpmn:lane id="Lane_AdminBadal" name="ADMIN BADAL &amp; WAKAF">
        <bpmn:flowNodeRef>Task_Badal_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Badal_Eksekusi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Badal_UploadBukti</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- ======================================================== -->
    <!-- SUB-PROSES: MANAJEMEN & PEMBUATAN PAKET UMROH (EXPANDED) -->
    <!-- ======================================================== -->
    <bpmn:subProcess id="SubProcess_ManajemenPaket" name="Sub-Proses: Pembuatan Paket (Manual / AI OCR Brosur) &amp; Manajemen Varian (Baru / Update / Split)">
      <bpmn:outgoing>F_Sub_To_Broadcast</bpmn:outgoing>
      
      <bpmn:startEvent id="Start_SubPaket" name="Mulai Pembuatan Paket">
        <bpmn:outgoing>F_Sub_Start</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:exclusiveGateway id="Gateway_InputMode" name="Metode Input Paket?">
        <bpmn:incoming>F_Sub_Start</bpmn:incoming>
        <bpmn:outgoing>F_Input_Manual</bpmn:outgoing>
        <bpmn:outgoing>F_Input_OCR</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:userTask id="Task_Sub_UploadFlyerCaption" name="Upload Flyer Brosur Umroh / Paste Caption Teks">
        <bpmn:incoming>F_Input_OCR</bpmn:incoming>
        <bpmn:outgoing>F_OCR_1</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:serviceTask id="Task_Sub_GeminiVisionOCR" name="Gemini AI Vision &amp; OCR (Ekstrak Jadwal, Maskapai, Hotel, Harga)">
        <bpmn:incoming>F_OCR_1</bpmn:incoming>
        <bpmn:outgoing>F_OCR_2</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:serviceTask id="Task_Sub_MasterMatcher" name="Auto-Match Master Data (Hotel, Maskapai, Rute) &amp; Resolusi Konflik">
        <bpmn:incoming>F_OCR_2</bpmn:incoming>
        <bpmn:outgoing>F_OCR_To_GateTipe</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:exclusiveGateway id="Gateway_TipePaket" name="Tipe / Output Paket?">
        <bpmn:incoming>F_Input_Manual</bpmn:incoming>
        <bpmn:incoming>F_OCR_To_GateTipe</bpmn:incoming>
        <bpmn:outgoing>F_Branch_Baru</bpmn:outgoing>
        <bpmn:outgoing>F_Branch_Update</bpmn:outgoing>
        <bpmn:outgoing>F_Branch_SplitStarting</bpmn:outgoing>
        <bpmn:outgoing>F_Branch_SplitPromo</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <!-- CABANG 1: PAKET BARU -->
      <bpmn:userTask id="Task_Sub_SetupKlaster" name="Setting Klaster (Gold/Silver) &amp; Pilihan Hotel">
        <bpmn:incoming>F_Branch_Baru</bpmn:incoming>
        <bpmn:outgoing>F_Baru_1</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:serviceTask id="Task_Sub_GenPaketIndependen" name="Generate X Paket Keberangkatan Independen">
        <bpmn:incoming>F_Baru_1</bpmn:incoming>
        <bpmn:outgoing>F_Baru_End</bpmn:outgoing>
      </bpmn:serviceTask>

      <!-- CABANG 2: UPDATE PAKET -->
      <bpmn:userTask id="Task_Sub_PilihExisting" name="Pilih Paket Existing &amp; Load Snapshot">
        <bpmn:incoming>F_Branch_Update</bpmn:incoming>
        <bpmn:outgoing>F_Update_1</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:userTask id="Task_Sub_UpdateParams" name="Update Jadwal, Kuota, Harga &amp; Hotel">
        <bpmn:incoming>F_Update_1</bpmn:incoming>
        <bpmn:outgoing>F_Update_2</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:serviceTask id="Task_Sub_AuditVersion" name="Pencatatan Versi Revisi &amp; Audit Log">
        <bpmn:incoming>F_Update_2</bpmn:incoming>
        <bpmn:outgoing>F_Update_End</bpmn:outgoing>
      </bpmn:serviceTask>

      <!-- CABANG 3: SPLIT STARTING -->
      <bpmn:userTask id="Task_Sub_SplitStarting" name="Pilih Parent Paket &amp; Tentukan Multi-Starting (JKT/SUB/KJT)">
        <bpmn:incoming>F_Branch_SplitStarting</bpmn:incoming>
        <bpmn:outgoing>F_Starting_1</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:serviceTask id="Task_Sub_GenerateChildStarting" name="Generate Child Package &amp; Link ke PaketGrup">
        <bpmn:incoming>F_Starting_1</bpmn:incoming>
        <bpmn:outgoing>F_Starting_End</bpmn:outgoing>
      </bpmn:serviceTask>

      <!-- CABANG 4: SPLIT PROMO -->
      <bpmn:userTask id="Task_Sub_SplitPromo" name="Duplikasi Paket untuk Skema Promo (Early Bird/Flash Sale)">
        <bpmn:incoming>F_Branch_SplitPromo</bpmn:incoming>
        <bpmn:outgoing>F_Promo_1</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:serviceTask id="Task_Sub_SetPromoPricing" name="Override Harga Promo &amp; Batas Kuota Khusus">
        <bpmn:incoming>F_Promo_1</bpmn:incoming>
        <bpmn:outgoing>F_Promo_End</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:exclusiveGateway id="Gateway_MergePaket" name="Merge">
        <bpmn:incoming>F_Baru_End</bpmn:incoming>
        <bpmn:incoming>F_Update_End</bpmn:incoming>
        <bpmn:incoming>F_Starting_End</bpmn:incoming>
        <bpmn:incoming>F_Promo_End</bpmn:incoming>
        <bpmn:outgoing>F_Merge_1</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:userTask id="Task_Sub_VerifKatalog" name="Validasi Kesiapan Paket &amp; Publish ke Katalog">
        <bpmn:incoming>F_Merge_1</bpmn:incoming>
        <bpmn:outgoing>F_Sub_Final</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:endEvent id="End_SubPaket" name="Paket Siap Dijual">
        <bpmn:incoming>F_Sub_Final</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="F_Sub_Start" sourceRef="Start_SubPaket" targetRef="Gateway_InputMode" />
      <bpmn:sequenceFlow id="F_Input_Manual" name="Manual Wizard" sourceRef="Gateway_InputMode" targetRef="Gateway_TipePaket" />
      <bpmn:sequenceFlow id="F_Input_OCR" name="AI OCR Brosur" sourceRef="Gateway_InputMode" targetRef="Task_Sub_UploadFlyerCaption" />
      <bpmn:sequenceFlow id="F_OCR_1" sourceRef="Task_Sub_UploadFlyerCaption" targetRef="Task_Sub_GeminiVisionOCR" />
      <bpmn:sequenceFlow id="F_OCR_2" sourceRef="Task_Sub_GeminiVisionOCR" targetRef="Task_Sub_MasterMatcher" />
      <bpmn:sequenceFlow id="F_OCR_To_GateTipe" sourceRef="Task_Sub_MasterMatcher" targetRef="Gateway_TipePaket" />
      <bpmn:sequenceFlow id="F_Branch_Baru" name="Paket Baru" sourceRef="Gateway_TipePaket" targetRef="Task_Sub_SetupKlaster" />
      <bpmn:sequenceFlow id="F_Baru_1" sourceRef="Task_Sub_SetupKlaster" targetRef="Task_Sub_GenPaketIndependen" />
      <bpmn:sequenceFlow id="F_Baru_End" sourceRef="Task_Sub_GenPaketIndependen" targetRef="Gateway_MergePaket" />
      <bpmn:sequenceFlow id="F_Branch_Update" name="Pembaruan" sourceRef="Gateway_TipePaket" targetRef="Task_Sub_PilihExisting" />
      <bpmn:sequenceFlow id="F_Update_1" sourceRef="Task_Sub_PilihExisting" targetRef="Task_Sub_UpdateParams" />
      <bpmn:sequenceFlow id="F_Update_2" sourceRef="Task_Sub_UpdateParams" targetRef="Task_Sub_AuditVersion" />
      <bpmn:sequenceFlow id="F_Update_End" sourceRef="Task_Sub_AuditVersion" targetRef="Gateway_MergePaket" />
      <bpmn:sequenceFlow id="F_Branch_SplitStarting" name="Split Starting" sourceRef="Gateway_TipePaket" targetRef="Task_Sub_SplitStarting" />
      <bpmn:sequenceFlow id="F_Starting_1" sourceRef="Task_Sub_SplitStarting" targetRef="Task_Sub_GenerateChildStarting" />
      <bpmn:sequenceFlow id="F_Starting_End" sourceRef="Task_Sub_GenerateChildStarting" targetRef="Gateway_MergePaket" />
      <bpmn:sequenceFlow id="F_Branch_SplitPromo" name="Split Promo" sourceRef="Gateway_TipePaket" targetRef="Task_Sub_SplitPromo" />
      <bpmn:sequenceFlow id="F_Promo_1" sourceRef="Task_Sub_SplitPromo" targetRef="Task_Sub_SetPromoPricing" />
      <bpmn:sequenceFlow id="F_Promo_End" sourceRef="Task_Sub_SetPromoPricing" targetRef="Gateway_MergePaket" />
      <bpmn:sequenceFlow id="F_Merge_1" sourceRef="Gateway_MergePaket" targetRef="Task_Sub_VerifKatalog" />
      <bpmn:sequenceFlow id="F_Sub_Final" sourceRef="Task_Sub_VerifKatalog" targetRef="End_SubPaket" />

    </bpmn:subProcess>

    <!-- FASE 1: BROADCAST PAKET -->
    <bpmn:serviceTask id="Task_Sys_BroadcastJadwal" name="Auto-Broadcast Jadwal Paket ke Telegram">
      <bpmn:incoming>F_Sub_To_Broadcast</bpmn:incoming>
      <bpmn:outgoing>F_Sys_1</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- FASE 2: ALUR PENDAFTARAN BARU JAMAAH (KOREKSI SESUAI INSTRUKSI) -->
    <bpmn:startEvent id="Start_VTU" name="Mulai Pendaftaran">
      <bpmn:outgoing>F_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- STEP 1: ISI DATA GROUP DULU -->
    <bpmn:userTask id="Task_J_RegisterGroup" name="1. Isi Data Group (PIC &amp; Anggota Rombongan)">
      <bpmn:incoming>F_Start</bpmn:incoming>
      <bpmn:outgoing>F_J_1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- STEP 2: PEMILIHAN PAKET -->
    <bpmn:userTask id="Task_J_PilihPaket" name="2. Pilih Paket &amp; Jadwal Keberangkatan Umroh">
      <bpmn:incoming>F_J_1</bpmn:incoming>
      <bpmn:incoming>F_Sys_1</bpmn:incoming>
      <bpmn:outgoing>F_J_2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- STEP 3: MENENTUKAN KOMPOSISI KAMAR -->
    <bpmn:userTask id="Task_J_KomposisiKamar" name="3. Tentukan Komposisi &amp; Pilihan Kamar (Quad/Triple/Double)">
      <bpmn:incoming>F_J_2</bpmn:incoming>
      <bpmn:outgoing>F_J_3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- STEP 4: KELUAR HASIL NOMINAL PEMBAYARAN & DP -->
    <bpmn:serviceTask id="Task_Sys_HitungNominal" name="4. Kalkulasi Otomatis Total Biaya &amp; Nominal Down Payment (DP)">
      <bpmn:incoming>F_J_3</bpmn:incoming>
      <bpmn:outgoing>F_Sys_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- STEP 5: JAMAAH UPLOAD BUKTI TF DP & SUBMIT -->
    <bpmn:userTask id="Task_J_UploadBuktiDP" name="5. Upload Bukti Transfer DP &amp; Submit Formulir">
      <bpmn:incoming>F_Sys_2</bpmn:incoming>
      <bpmn:incoming>F_Reg_Revisi</bpmn:incoming>
      <bpmn:outgoing>F_J_4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- STEP 6: SETELAH SUBMIT, SISTEM GENERATE PDF FORMULIR -->
    <bpmn:serviceTask id="Task_Sys_GenPDF" name="6. Generate PDF Formulir Pendaftaran VTU &amp; Notifikasi">
      <bpmn:incoming>F_J_4</bpmn:incoming>
      <bpmn:outgoing>F_Sys_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- STEP 7: MASUK KE PENINJAUAN ADMIN -->
    <bpmn:userTask id="Task_Ops_ReviewRegistrasi" name="7. Peninjauan Registrasi Baru &amp; Validasi Bukti Transfer DP">
      <bpmn:incoming>F_Sys_3</bpmn:incoming>
      <bpmn:outgoing>F_Ops_Review</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ReviewReg" name="Registrasi &amp; Bukti DP Valid?">
      <bpmn:incoming>F_Ops_Review</bpmn:incoming>
      <bpmn:outgoing>F_Reg_Valid</bpmn:outgoing>
      <bpmn:outgoing>F_Reg_Revisi</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- STEP 8: SETELAH DITINJAU, INVOICE DITERBITKAN -->
    <bpmn:userTask id="Task_Pay_TerbitkanInvoice" name="8. Terbitkan Invoice Resmi (Invoice DP &amp; Group)">
      <bpmn:incoming>F_Reg_Valid</bpmn:incoming>
      <bpmn:outgoing>F_Pay_Inv</bpmn:outgoing>
    </bpmn:userTask>

    <!-- STEP 9: DATA JAMAAH MASUK KE MANIFEST -->
    <bpmn:serviceTask id="Task_Sys_IngestManifest" name="9. Approve Registrasi, Buat Akun &amp; Ingest ke Manifest">
      <bpmn:incoming>F_Pay_Inv</bpmn:incoming>
      <bpmn:outgoing>F_Sys_Manifest</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- STEP 10: JAMAAH LANGSUNG MENGAMBIL PERLENGKAPAN -->
    <bpmn:userTask id="Task_J_AmbilPerlengkapan" name="10. Pengambilan Perlengkapan Umroh (Koper, Ihram, Seragam)">
      <bpmn:incoming>F_Sys_Manifest</bpmn:incoming>
      <bpmn:outgoing>F_J_Ambil</bpmn:outgoing>
    </bpmn:userTask>

    <!-- FASE 3: SIKLUS DOKUMEN & AI OCR (PASPOR & VISA) -->
    <bpmn:userTask id="Task_J_UploadDokumen" name="Upload Berkas Paspor &amp; Dokumen Visa">
      <bpmn:incoming>F_J_Ambil</bpmn:incoming>
      <bpmn:incoming>F_Doc_Revisi</bpmn:incoming>
      <bpmn:outgoing>F_J_Doc</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Sys_OCRTrigger" name="Ekstraksi Gemini OCR &amp; Quality Check (isBlurry/Readable)">
      <bpmn:incoming>F_J_Doc</bpmn:incoming>
      <bpmn:outgoing>F_Sys_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_OCRConfidence" name="OCR Valid &amp; Jelas?">
      <bpmn:incoming>F_Sys_4</bpmn:incoming>
      <bpmn:outgoing>F_OCR_Auto</bpmn:outgoing>
      <bpmn:outgoing>F_OCR_Manual</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Doc_ManualReview" name="Manual Edit &amp; Handling Foto Buram">
      <bpmn:incoming>F_OCR_Manual</bpmn:incoming>
      <bpmn:outgoing>F_Doc_1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Doc_VerifyData" name="Verifikasi Paspor, KTP &amp; Masa Berlaku (>6 Bln)">
      <bpmn:incoming>F_OCR_Auto</bpmn:incoming>
      <bpmn:incoming>F_Doc_1</bpmn:incoming>
      <bpmn:outgoing>F_Doc_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_DocStatus" name="Status Dokumen?">
      <bpmn:incoming>F_Doc_2</bpmn:incoming>
      <bpmn:outgoing>F_Doc_Verified</bpmn:outgoing>
      <bpmn:outgoing>F_Doc_Revisi</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Sys_CalcReadiness" name="Kalkulasi Otomatis Jamaah Readiness Score">
      <bpmn:incoming>F_Doc_Verified</bpmn:incoming>
      <bpmn:outgoing>F_Sys_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- FASE 4: PELUNASAN SISA TAGIHAN, SPLIT BILL & REKONSILIASI -->
    <bpmn:userTask id="Task_Pay_InvoicePelunasan" name="Generate Invoice Pelunasan &amp; Setting Split Group (A/B/C)">
      <bpmn:incoming>F_Sys_5</bpmn:incoming>
      <bpmn:outgoing>F_Pay_1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_J_BayarPelunasan" name="Pelunasan Pembayaran &amp; Upload Bukti Transfer">
      <bpmn:incoming>F_Pay_1</bpmn:incoming>
      <bpmn:incoming>F_Pay_Reject</bpmn:incoming>
      <bpmn:outgoing>F_J_Pelunasan</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Sys_OCRPembayaran" name="AI OCR Bukti Transfer (Cek Nominal, Rekening &amp; Tgl)">
      <bpmn:incoming>F_J_Pelunasan</bpmn:incoming>
      <bpmn:outgoing>F_Sys_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_Pay_ReviewPembayaran" name="Review &amp; Rekonsiliasi Pelunasan Bank">
      <bpmn:incoming>F_Sys_6</bpmn:incoming>
      <bpmn:outgoing>F_Pay_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_PayApproval" name="Pembayaran Valid?">
      <bpmn:incoming>F_Pay_2</bpmn:incoming>
      <bpmn:outgoing>F_Pay_Approve</bpmn:outgoing>
      <bpmn:outgoing>F_Pay_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_Pay_Alokasi" name="Alokasi Pembayaran per Anggota Grup">
      <bpmn:incoming>F_Pay_Approve</bpmn:incoming>
      <bpmn:outgoing>F_Pay_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Sys_SendReceipt" name="Generate E-Kwitansi &amp; Broadcast Notif Lunas (Telegram)">
      <bpmn:incoming>F_Pay_3</bpmn:incoming>
      <bpmn:outgoing>F_Sys_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_J_TerimaKwitansi" name="Menerima Kwitansi Resmi &amp; Jadwal Final">
      <bpmn:incoming>F_Sys_7</bpmn:incoming>
      <bpmn:outgoing>F_J_5</bpmn:outgoing>
      <bpmn:outgoing>F_J_Badal</bpmn:outgoing>
    </bpmn:userTask>

    <!-- FASE 5: MANIFEST INTELLIGENCE & ROOMING ENGINE -->
    <bpmn:userTask id="Task_Man_Provisioning" name="Finalisasi Data Manifest Jamaah Lunas">
      <bpmn:incoming>F_J_5</bpmn:incoming>
      <bpmn:outgoing>F_Man_1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Man_SplitHotel" name="Grouping Kombinasi Hotel Mekkah &amp; Madinah">
      <bpmn:incoming>F_Man_1</bpmn:incoming>
      <bpmn:outgoing>F_Man_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Sys_GenManifestNumber" name="Dynamic Manifest Numbering (MAN/UMRH-BLN/NNN)">
      <bpmn:incoming>F_Man_2</bpmn:incoming>
      <bpmn:outgoing>F_Sys_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_Man_RoomingEngine" name="Alokasi Kamar (Quad/Triple/Double, Gender &amp; Mahram)">
      <bpmn:incoming>F_Sys_8</bpmn:incoming>
      <bpmn:outgoing>F_Man_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ManifestFinal" name="Manifest &amp; Rooming Siap?">
      <bpmn:incoming>F_Man_3</bpmn:incoming>
      <bpmn:outgoing>F_Man_Yes</bpmn:outgoing>
      <bpmn:outgoing>F_Man_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- FASE 6: OPERASIONAL KEBERANGKATAN & TOUR LEADER -->
    <bpmn:serviceTask id="Task_Sys_AutoDeadlines" name="Auto Deadlines Engine (H-30, H-7 Reminder via Telegram)">
      <bpmn:incoming>F_Man_Yes</bpmn:incoming>
      <bpmn:outgoing>F_Sys_9</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_TL_Handover" name="Handover Final Manifest &amp; Rooming List ke Tour Leader">
      <bpmn:incoming>F_Sys_9</bpmn:incoming>
      <bpmn:outgoing>F_TL_1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_TL_BriefingManasik" name="Pelaksanaan Manasik &amp; Briefing Jamaah">
      <bpmn:incoming>F_TL_1</bpmn:incoming>
      <bpmn:outgoing>F_TL_2</bpmn:outgoing>
      <bpmn:outgoing>F_TL_Damping</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_J_Berangkat" name="Berangkat Umroh &amp; Ibadah di Tanah Suci">
      <bpmn:incoming>F_TL_2</bpmn:incoming>
      <bpmn:outgoing>F_J_6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_TL_Dampingan" name="Pendampingan Lapangan, Check-in Hotel &amp; Mutawif">
      <bpmn:incoming>F_TL_Damping</bpmn:incoming>
      <bpmn:outgoing>F_TL_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_J_Pulang" name="Kepulangan Jamaah ke Tanah Air">
      <bpmn:incoming>F_J_6</bpmn:incoming>
      <bpmn:outgoing>F_J_7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_TL_Laporan" name="Laporan Perjalanan &amp; Upload Dokumentasi">
      <bpmn:incoming>F_TL_3</bpmn:incoming>
      <bpmn:outgoing>F_TL_4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- FASE 7: LAYANAN KHUSUS (BADAL/WAKAF) & ARSIP AUDIT -->
    <bpmn:userTask id="Task_Badal_Order" name="Pemrosesan Order Layanan Badal Umroh &amp; Wakaf">
      <bpmn:incoming>F_J_Badal</bpmn:incoming>
      <bpmn:outgoing>F_Badal_1</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Badal_Eksekusi" name="Pelaksanaan Ibadah Badal &amp; Penyerahan Mushaf di Makkah">
      <bpmn:incoming>F_Badal_1</bpmn:incoming>
      <bpmn:outgoing>F_Badal_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Badal_UploadBukti" name="Upload Dokumentasi Video &amp; Sertifikat Badal">
      <bpmn:incoming>F_Badal_2</bpmn:incoming>
      <bpmn:outgoing>F_Badal_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_Ops_ClosingPaket" name="Closing Paket Keberangkatan &amp; Evaluasi">
      <bpmn:incoming>F_Badal_3</bpmn:incoming>
      <bpmn:incoming>F_J_7</bpmn:incoming>
      <bpmn:incoming>F_TL_4</bpmn:incoming>
      <bpmn:outgoing>F_Ops_3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_Sys_SyncDrive" name="Sinkronisasi Berkas ke Google Drive Vault">
      <bpmn:incoming>F_Ops_3</bpmn:incoming>
      <bpmn:outgoing>F_Sys_10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Sys_AuditLog" name="Pencatatan Audit Trail ke Immutable Log">
      <bpmn:incoming>F_Sys_10</bpmn:incoming>
      <bpmn:outgoing>F_Sys_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_VTU" name="Selesai / Alumni">
      <bpmn:incoming>F_Sys_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- DATA OBJECT REFERENCES -->
    <bpmn:dataObject id="DO_GroupData" />
    <bpmn:dataObjectReference id="DataObjectRef_GroupData" name="Data Group &amp; Jamaah" dataObjectRef="DO_GroupData" />

    <bpmn:dataObject id="DO_BuktiDP" />
    <bpmn:dataObjectReference id="DataObjectRef_BuktiDP" name="Bukti Transfer DP" dataObjectRef="DO_BuktiDP" />

    <bpmn:dataObject id="DO_PDFFormulir" />
    <bpmn:dataObjectReference id="DataObjectRef_PDFFormulir" name="PDF Formulir Resmi VTU" dataObjectRef="DO_PDFFormulir" />

    <bpmn:dataObject id="DO_Berkas" />
    <bpmn:dataObjectReference id="DataObjectRef_Berkas" name="Berkas Paspor &amp; Foto" dataObjectRef="DO_Berkas" />

    <bpmn:dataObject id="DO_SplitConfig" />
    <bpmn:dataObjectReference id="DataObjectRef_SplitConfig" name="Split Invoice Config" dataObjectRef="DO_SplitConfig" />

    <bpmn:dataObject id="DO_BuktiBayar" />
    <bpmn:dataObjectReference id="DataObjectRef_BuktiBayar" name="Bukti Transfer Pelunasan" dataObjectRef="DO_BuktiBayar" />

    <bpmn:dataObject id="DO_Kwitansi" />
    <bpmn:dataObjectReference id="DataObjectRef_Kwitansi" name="E-Kwitansi Resmi VTU" dataObjectRef="DO_Kwitansi" />

    <bpmn:dataObject id="DO_FinalManifest" />
    <bpmn:dataObjectReference id="DataObjectRef_FinalManifest" name="Final Manifest &amp; Rooming" dataObjectRef="DO_FinalManifest" />

    <bpmn:dataObject id="DO_SertifikatBadal" />
    <bpmn:dataObjectReference id="DataObjectRef_SertifikatBadal" name="Sertifikat &amp; Dokumentasi Badal" dataObjectRef="DO_SertifikatBadal" />

    <!-- DATA STORES -->
    <bpmn:dataStoreReference id="DataStoreRef_Paket" name="DB Keberangkatan" />
    <bpmn:dataStoreReference id="DataStoreRef_Group" name="DB Group &amp; Jamaah" />
    <bpmn:dataStoreReference id="DataStoreRef_OCR" name="DB Dokumen &amp; OCR" />
    <bpmn:dataStoreReference id="DataStoreRef_Invoice" name="DB Invoice" />
    <bpmn:dataStoreReference id="DataStoreRef_Pembayaran" name="DB Pembayaran" />
    <bpmn:dataStoreReference id="DataStoreRef_Manifest" name="DB Manifest" />
    <bpmn:dataStoreReference id="DataStoreRef_Rooming" name="DB Rooming &amp; Kamar" />
    <bpmn:dataStoreReference id="DataStoreRef_Badal" name="DB Badal &amp; Wakaf" />
    <bpmn:dataStoreReference id="DataStoreRef_Audit" name="DB Audit Trail (Immutable)" />

    <!-- ASSOCIATIONS -->
    <bpmn:association id="Assoc_Paket" sourceRef="SubProcess_ManajemenPaket" targetRef="DataStoreRef_Paket" />
    <bpmn:association id="Assoc_Group" sourceRef="Task_J_RegisterGroup" targetRef="DataObjectRef_GroupData" />
    <bpmn:association id="Assoc_BuktiDP" sourceRef="Task_J_UploadBuktiDP" targetRef="DataObjectRef_BuktiDP" />
    <bpmn:association id="Assoc_PDF" sourceRef="Task_Sys_GenPDF" targetRef="DataObjectRef_PDFFormulir" />
    <bpmn:association id="Assoc_DBGroup" sourceRef="Task_Sys_IngestManifest" targetRef="DataStoreRef_Group" />
    <bpmn:association id="Assoc_Berkas" sourceRef="Task_J_UploadDokumen" targetRef="DataObjectRef_Berkas" />
    <bpmn:association id="Assoc_OCR" sourceRef="Task_Sys_OCRTrigger" targetRef="DataStoreRef_OCR" />
    <bpmn:association id="Assoc_Split" sourceRef="Task_Pay_InvoicePelunasan" targetRef="DataObjectRef_SplitConfig" />
    <bpmn:association id="Assoc_Invoice" sourceRef="Task_Pay_TerbitkanInvoice" targetRef="DataStoreRef_Invoice" />
    <bpmn:association id="Assoc_Bukti" sourceRef="Task_J_BayarPelunasan" targetRef="DataObjectRef_BuktiBayar" />
    <bpmn:association id="Assoc_Pay" sourceRef="Task_Pay_Alokasi" targetRef="DataStoreRef_Pembayaran" />
    <bpmn:association id="Assoc_Kwitansi" sourceRef="Task_Sys_SendReceipt" targetRef="DataObjectRef_Kwitansi" />
    <bpmn:association id="Assoc_Manifest" sourceRef="Task_Man_Provisioning" targetRef="DataStoreRef_Manifest" />
    <bpmn:association id="Assoc_Rooming" sourceRef="Task_Man_RoomingEngine" targetRef="DataStoreRef_Rooming" />
    <bpmn:association id="Assoc_DocTL" sourceRef="Task_TL_Handover" targetRef="DataObjectRef_FinalManifest" />
    <bpmn:association id="Assoc_Badal" sourceRef="Task_Badal_Order" targetRef="DataStoreRef_Badal" />
    <bpmn:association id="Assoc_Sertifikat" sourceRef="Task_Badal_UploadBukti" targetRef="DataObjectRef_SertifikatBadal" />
    <bpmn:association id="Assoc_Audit" sourceRef="Task_Sys_AuditLog" targetRef="DataStoreRef_Audit" />

    <!-- MAIN SEQUENCE FLOW EDGES -->
    <bpmn:sequenceFlow id="F_Sub_To_Broadcast" sourceRef="SubProcess_ManajemenPaket" targetRef="Task_Sys_BroadcastJadwal" />
    <bpmn:sequenceFlow id="F_Sys_1" sourceRef="Task_Sys_BroadcastJadwal" targetRef="Task_J_PilihPaket" />
    
    <!-- STEP 1 -> STEP 2 -> STEP 3 -> STEP 4 -> STEP 5 -> STEP 6 -> STEP 7 -> STEP 8 -> STEP 9 -> STEP 10 -->
    <bpmn:sequenceFlow id="F_Start" sourceRef="Start_VTU" targetRef="Task_J_RegisterGroup" />
    <bpmn:sequenceFlow id="F_J_1" sourceRef="Task_J_RegisterGroup" targetRef="Task_J_PilihPaket" />
    <bpmn:sequenceFlow id="F_J_2" sourceRef="Task_J_PilihPaket" targetRef="Task_J_KomposisiKamar" />
    <bpmn:sequenceFlow id="F_J_3" sourceRef="Task_J_KomposisiKamar" targetRef="Task_Sys_HitungNominal" />
    <bpmn:sequenceFlow id="F_Sys_2" sourceRef="Task_Sys_HitungNominal" targetRef="Task_J_UploadBuktiDP" />
    <bpmn:sequenceFlow id="F_J_4" sourceRef="Task_J_UploadBuktiDP" targetRef="Task_Sys_GenPDF" />
    <bpmn:sequenceFlow id="F_Sys_3" sourceRef="Task_Sys_GenPDF" targetRef="Task_Ops_ReviewRegistrasi" />
    <bpmn:sequenceFlow id="F_Ops_Review" sourceRef="Task_Ops_ReviewRegistrasi" targetRef="Gateway_ReviewReg" />
    <bpmn:sequenceFlow id="F_Reg_Valid" name="Valid / Approve" sourceRef="Gateway_ReviewReg" targetRef="Task_Pay_TerbitkanInvoice" />
    <bpmn:sequenceFlow id="F_Reg_Revisi" name="Revisi Data/Bukti" sourceRef="Gateway_ReviewReg" targetRef="Task_J_UploadBuktiDP" />
    <bpmn:sequenceFlow id="F_Pay_Inv" sourceRef="Task_Pay_TerbitkanInvoice" targetRef="Task_Sys_IngestManifest" />
    <bpmn:sequenceFlow id="F_Sys_Manifest" sourceRef="Task_Sys_IngestManifest" targetRef="Task_J_AmbilPerlengkapan" />
    <bpmn:sequenceFlow id="F_J_Ambil" sourceRef="Task_J_AmbilPerlengkapan" targetRef="Task_J_UploadDokumen" />

    <!-- DOKUMEN & PASPOR SIKLUS -->
    <bpmn:sequenceFlow id="F_J_Doc" sourceRef="Task_J_UploadDokumen" targetRef="Task_Sys_OCRTrigger" />
    <bpmn:sequenceFlow id="F_Sys_4" sourceRef="Task_Sys_OCRTrigger" targetRef="Gateway_OCRConfidence" />
    <bpmn:sequenceFlow id="F_OCR_Auto" name="Confidence Tinggi" sourceRef="Gateway_OCRConfidence" targetRef="Task_Doc_VerifyData" />
    <bpmn:sequenceFlow id="F_OCR_Manual" name="Buram / Rendah" sourceRef="Gateway_OCRConfidence" targetRef="Task_Doc_ManualReview" />
    <bpmn:sequenceFlow id="F_Doc_1" sourceRef="Task_Doc_ManualReview" targetRef="Task_Doc_VerifyData" />
    <bpmn:sequenceFlow id="F_Doc_2" sourceRef="Task_Doc_VerifyData" targetRef="Gateway_DocStatus" />
    <bpmn:sequenceFlow id="F_Doc_Verified" name="Lengkap" sourceRef="Gateway_DocStatus" targetRef="Task_Sys_CalcReadiness" />
    <bpmn:sequenceFlow id="F_Doc_Revisi" name="Revisi" sourceRef="Gateway_DocStatus" targetRef="Task_J_UploadDokumen" />

    <!-- PELUNASAN -->
    <bpmn:sequenceFlow id="F_Sys_5" sourceRef="Task_Sys_CalcReadiness" targetRef="Task_Pay_InvoicePelunasan" />
    <bpmn:sequenceFlow id="F_Pay_1" sourceRef="Task_Pay_InvoicePelunasan" targetRef="Task_J_BayarPelunasan" />
    <bpmn:sequenceFlow id="F_J_Pelunasan" sourceRef="Task_J_BayarPelunasan" targetRef="Task_Sys_OCRPembayaran" />
    <bpmn:sequenceFlow id="F_Sys_6" sourceRef="Task_Sys_OCRPembayaran" targetRef="Task_Pay_ReviewPembayaran" />
    <bpmn:sequenceFlow id="F_Pay_2" sourceRef="Task_Pay_ReviewPembayaran" targetRef="Gateway_PayApproval" />
    <bpmn:sequenceFlow id="F_Pay_Approve" name="Valid / Lunas" sourceRef="Gateway_PayApproval" targetRef="Task_Pay_Alokasi" />
    <bpmn:sequenceFlow id="F_Pay_Reject" name="Reject" sourceRef="Gateway_PayApproval" targetRef="Task_J_BayarPelunasan" />
    <bpmn:sequenceFlow id="F_Pay_3" sourceRef="Task_Pay_Alokasi" targetRef="Task_Sys_SendReceipt" />
    <bpmn:sequenceFlow id="F_Sys_7" sourceRef="Task_Sys_SendReceipt" targetRef="Task_J_TerimaKwitansi" />

    <!-- MANIFEST FINAL & ROOMING -->
    <bpmn:sequenceFlow id="F_J_5" sourceRef="Task_J_TerimaKwitansi" targetRef="Task_Man_Provisioning" />
    <bpmn:sequenceFlow id="F_Man_1" sourceRef="Task_Man_Provisioning" targetRef="Task_Man_SplitHotel" />
    <bpmn:sequenceFlow id="F_Man_2" sourceRef="Task_Man_SplitHotel" targetRef="Task_Sys_GenManifestNumber" />
    <bpmn:sequenceFlow id="F_Sys_8" sourceRef="Task_Sys_GenManifestNumber" targetRef="Task_Man_RoomingEngine" />
    <bpmn:sequenceFlow id="F_Man_3" sourceRef="Task_Man_RoomingEngine" targetRef="Gateway_ManifestFinal" />
    <bpmn:sequenceFlow id="F_Man_Yes" name="Final" sourceRef="Gateway_ManifestFinal" targetRef="Task_Sys_AutoDeadlines" />
    <bpmn:sequenceFlow id="F_Man_No" name="Adjust" sourceRef="Gateway_ManifestFinal" targetRef="Task_Man_RoomingEngine" />

    <!-- TOUR LEADER & KEBERANGKATAN -->
    <bpmn:sequenceFlow id="F_Sys_9" sourceRef="Task_Sys_AutoDeadlines" targetRef="Task_TL_Handover" />
    <bpmn:sequenceFlow id="F_TL_1" sourceRef="Task_TL_Handover" targetRef="Task_TL_BriefingManasik" />
    <bpmn:sequenceFlow id="F_TL_2" sourceRef="Task_TL_BriefingManasik" targetRef="Task_J_Berangkat" />
    <bpmn:sequenceFlow id="F_TL_Damping" sourceRef="Task_TL_BriefingManasik" targetRef="Task_TL_Dampingan" />
    <bpmn:sequenceFlow id="F_J_6" sourceRef="Task_J_Berangkat" targetRef="Task_J_Pulang" />
    <bpmn:sequenceFlow id="F_TL_3" sourceRef="Task_TL_Dampingan" targetRef="Task_TL_Laporan" />

    <!-- BADAL & CLOSING -->
    <bpmn:sequenceFlow id="F_J_Badal" sourceRef="Task_J_TerimaKwitansi" targetRef="Task_Badal_Order" />
    <bpmn:sequenceFlow id="F_Badal_1" sourceRef="Task_Badal_Order" targetRef="Task_Badal_Eksekusi" />
    <bpmn:sequenceFlow id="F_Badal_2" sourceRef="Task_Badal_Eksekusi" targetRef="Task_Badal_UploadBukti" />
    <bpmn:sequenceFlow id="F_Badal_3" sourceRef="Task_Badal_UploadBukti" targetRef="Task_Ops_ClosingPaket" />
    <bpmn:sequenceFlow id="F_J_7" sourceRef="Task_J_Pulang" targetRef="Task_Ops_ClosingPaket" />
    <bpmn:sequenceFlow id="F_TL_4" sourceRef="Task_TL_Laporan" targetRef="Task_Ops_ClosingPaket" />
    <bpmn:sequenceFlow id="F_Ops_3" sourceRef="Task_Ops_ClosingPaket" targetRef="Task_Sys_SyncDrive" />
    <bpmn:sequenceFlow id="F_Sys_10" sourceRef="Task_Sys_SyncDrive" targetRef="Task_Sys_AuditLog" />
    <bpmn:sequenceFlow id="F_Sys_End" sourceRef="Task_Sys_AuditLog" targetRef="End_VTU" />

  </bpmn:process>

  <!-- BPMNDI VISUAL REPRESENTATION -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_VTU">
    <bpmndi:BPMNPlane id="BPMNPlane_VTU" bpmnElement="Collaboration_VTU">

      <!-- PARTICIPANT / POOL -->
      <bpmndi:BPMNShape id="Participant_VTU_di" bpmnElement="Participant_VTU" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="6350" height="1345" />
      </bpmndi:BPMNShape>

      <!-- ROW 1: JAMAAH -->
      <bpmndi:BPMNShape id="Lane_Jamaah_di" bpmnElement="Lane_Jamaah" isHorizontal="true" bioc:stroke="#0288d1" bioc:fill="#e1f5fe">
        <dc:Bounds x="190" y="80" width="6320" height="150" />
      </bpmndi:BPMNShape>

      <!-- ROW 2: SISTEM VTU & AI ENGINE -->
      <bpmndi:BPMNShape id="Lane_SistemAI_di" bpmnElement="Lane_SistemAI" isHorizontal="true" bioc:stroke="#455a64" bioc:fill="#eceff1">
        <dc:Bounds x="190" y="230" width="6320" height="150" />
      </bpmndi:BPMNShape>

      <!-- ROW 3: ADMIN OPERASIONAL -->
      <bpmndi:BPMNShape id="Lane_AdminOps_di" bpmnElement="Lane_AdminOps" isHorizontal="true" bioc:stroke="#2e7d32" bioc:fill="#e8f5e9">
        <dc:Bounds x="190" y="380" width="6320" height="370" />
      </bpmndi:BPMNShape>

      <!-- ROW 4: ADMIN DOKUMEN -->
      <bpmndi:BPMNShape id="Lane_AdminDoc_di" bpmnElement="Lane_AdminDoc" isHorizontal="true" bioc:stroke="#f57f17" bioc:fill="#fffde7">
        <dc:Bounds x="190" y="750" width="6320" height="135" />
      </bpmndi:BPMNShape>

      <!-- ROW 5: ADMIN PEMBAYARAN -->
      <bpmndi:BPMNShape id="Lane_AdminPay_di" bpmnElement="Lane_AdminPay" isHorizontal="true" bioc:stroke="#c2185b" bioc:fill="#fce4ec">
        <dc:Bounds x="190" y="885" width="6320" height="135" />
      </bpmndi:BPMNShape>

      <!-- ROW 6: ADMIN MANIFEST & ROOMING -->
      <bpmndi:BPMNShape id="Lane_AdminMan_di" bpmnElement="Lane_AdminMan" isHorizontal="true" bioc:stroke="#7b1fa2" bioc:fill="#f3e5f5">
        <dc:Bounds x="190" y="1020" width="6320" height="135" />
      </bpmndi:BPMNShape>

      <!-- ROW 7: TOUR LEADER -->
      <bpmndi:BPMNShape id="Lane_TourLeader_di" bpmnElement="Lane_TourLeader" isHorizontal="true" bioc:stroke="#0097a7" bioc:fill="#e0f7fa">
        <dc:Bounds x="190" y="1155" width="6320" height="135" />
      </bpmndi:BPMNShape>

